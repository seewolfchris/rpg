APP_NAME="C76-RPG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DEINE-DOMAIN.TLD
APP_VERSION=
# Optional: kurzer Build-Hinweis (z. B. Git-Hash)
APP_BUILD=
# Standard-Welt fuer Routing/Fallbacks (muss als aktive Welt in der DB existieren)
WORLD_DEFAULT_SLUG=chroniken-der-asche

# Optionaler MySQL-Hotpath-Hint fuer posts.latest_by_id:
PERF_POSTS_LATEST_BY_ID_FORCE_INDEX=false
PERF_POSTS_LATEST_BY_ID_FORCE_INDEX_NAME=posts_scene_id_id_idx

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

PRIVACY_NOINDEX_HEADERS=true
PRIVACY_BLOCK_KNOWN_BOTS=true
PRIVACY_ALLOW_LINK_PREVIEW_BOTS=true
# PRIVACY_X_ROBOTS_TAG="noindex, nofollow, noarchive, nosnippet, noimageindex, max-snippet:0, max-image-preview:none, max-video-preview:0"

# Content-/Feature-Flags
WORLD_MARKDOWN_PREVIEW=false
FEATURE_WAVE3_EDITOR_PREVIEW=false
FEATURE_WAVE3_DRAFT_AUTOSAVE=false
FEATURE_WAVE4_MENTIONS=false
FEATURE_WAVE4_REACTIONS=false
FEATURE_WAVE4_ACTIVE_CHARACTERS=false
COMBAT_TOOLS_ENABLED=false

# Outbox-Spike: nur strukturierte Kandidaten-Logs, keine persistente Outbox
OUTBOX_SPIKE_LOG_CANDIDATES=false
OUTBOX_MAX_PAYLOAD_BYTES=4096

# Rechtliche Seiten (Impressum/Datenschutz/Urheberrecht)
LEGAL_RESPONSIBLE_NAME=
LEGAL_RESPONSIBLE_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_CONTENT_RESPONSIBLE=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTROLLER_EMAIL=
LEGAL_RIGHTS_CONTACT=
LEGAL_RIGHTS_CONTACT_NOTE=
LEGAL_SOURCE_IMPRINT_URL=https://c76.org/impressum/
LEGAL_SOURCE_PRIVACY_URL=https://c76.org/datenschutz/
LEGAL_SCOPE_NOTE="Dieses Impressum gilt für c76.org und zugehörige Subdomains, inklusive rpg.c76.org."

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Produktion: MySQL/MariaDB nutzen (nicht sqlite)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=DEINE_DB
DB_USERNAME=DEIN_DB_USER
DB_PASSWORD=DEIN_DB_PASSWORT

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public

# Produktion: asynchrone Retry-Jobs brauchen einen Worker.
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
TRUSTED_PROXIES=<proxy-ip/cidr,...>
SECURITY_HSTS_MAX_AGE=31536000

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default

# Web Push (VAPID)
VAPID_SUBJECT=mailto:admin@c76.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_DB_TABLE=push_subscriptions
# Optional override (default folgt DB_CONNECTION):
# WEBPUSH_DB_CONNECTION=mysql
WEBPUSH_AUTOMATIC_PADDING=true
WEBPUSH_TTL=300
WEBPUSH_ICON=/images/icons/icon-192.png
WEBPUSH_BADGE=/images/icons/icon-96.png
WEBPUSH_ENDPOINT_ALLOWED_HOSTS=fcm.googleapis.com,fcmregistrations.googleapis.com,*.push.services.mozilla.com,web.push.apple.com,*.web.push.apple.com

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=DEIN_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=DEIN_SMTP_USER
MAIL_PASSWORD=DEIN_SMTP_PASSWORT
MAIL_FROM_ADDRESS="noreply@DEINE-DOMAIN.TLD"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
